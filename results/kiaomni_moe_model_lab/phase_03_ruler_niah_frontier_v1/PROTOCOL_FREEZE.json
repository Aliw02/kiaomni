{
  "version": "KIAOMNI_QWEN3_RULER_NIAH_FRONTIER_V1",
  "date": "2026-10-02",
  "purpose": "Controlled long-context retention audit using official NVIDIA/RULER NIAH data generation with the frozen Qwen3-30B KiaOmni policies and percentage budgets.",
  "ruler": {
    "repo": "NVIDIA/RULER",
    "revision": "c3f5e3b4f87f97e048793bb510a3a6b19a46bf3a",
    "source": "scripts/data/prepare.py",
    "tasks": [
      "niah_single_1",
      "niah_multikey_2",
      "niah_multikey_3"
    ],
    "lengths": [
      8192,
      16384
    ],
    "samples_per_task": 4,
    "tokenizer_type": "hf",
    "model_template_type": "base",
    "random_seed": 42
  },
  "kiaomni": {
    "policies": [
      "kiaomni_s8",
      "kiaomni_gaussian"
    ],
    "percentage_budgets": [
      0.25,
      0.125,
      0.0625
    ],
    "n_sink": 16,
    "recency": 32,
    "max_new_tokens": 128
  },
  "metrics": {
    "official_style": [
      "ruler_score_string_match_all",
      "all_reference_accuracy"
    ],
    "retention": [
      "gold_token_recall",
      "complete_reference_survival",
      "all_references_survived_rate",
      "needle_depth_pct"
    ],
    "routing": [
      "top1_expert_agreement",
      "top8_set_jaccard",
      "dispatch_weight_cosine",
      "expert_load_jsd",
      "per_layer"
    ],
    "quality": [
      "gold_answer_nll",
      "gold_answer_ppl"
    ],
    "systems": [
      "generation_peak_vram",
      "pipeline_peak_vram",
      "output_tokens_per_second",
      "generation_elapsed_seconds",
      "saliency_elapsed_seconds",
      "inference_path_elapsed_seconds"
    ]
  },
  "notes": [
    "RULER data is generated by the pinned upstream NVIDIA script using the frozen Qwen tokenizer.",
    "This fast frontier stage intentionally uses a small pre-registered sample count for same-day validation; it is not the final paper-scale RULER run.",
    "The primary new diagnostic is whether the gold/reference token span physically survives KiaOmni selection before generation."
  ]
}
