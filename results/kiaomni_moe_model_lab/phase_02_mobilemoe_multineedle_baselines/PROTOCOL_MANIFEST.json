{
  "protocol": "KIAOMNI_MOE_MODEL_LAB_PHASE02_PROTOCOL_V1",
  "model": "facebook/MobileMoE-M-SFT",
  "precision": "FP16",
  "device_protocol": "single Kaggle GPU; model placed on cuda:0",
  "context": {
    "target_rendered_prompt_tokens": 3900,
    "hard_max_rendered_prompt_tokens": 4096,
    "measured_after_chat_template": true
  },
  "budgets": [
    512,
    256,
    128,
    98
  ],
  "tasks": [
    "single",
    "multi",
    "hard_multi",
    "reason"
  ],
  "methods": {
    "full_context": {
      "ownership": "control",
      "compression": "none"
    },
    "kiaomni_s8": {
      "ownership": "ours",
      "compression": "prompt-side",
      "policy": "kiaomni_s8",
      "exact_budget": true
    },
    "blocksal": {
      "ownership": "ours",
      "compression": "prompt-side block selection",
      "block_size": 16,
      "n_sink": 16,
      "recency": 32,
      "selector": "historical whole-block mean saliency",
      "exact_budget": false,
      "disclosure": "Actual kept tokens and budget delta must be recorded.",
      "provenance": "KiaOmni paper/full-comparison lineage; our design, not external SnapKV."
    },
    "snapkv": {
      "ownership": "external",
      "implementation": "NVIDIA/kvpress SnapKVPress",
      "kvpress_commit": "7331c23da9e6f1510d89ea651d0dea77a57b3252",
      "kvpress_version": "0.5.5",
      "window_size": 64,
      "kernel_size": 5,
      "exact_budget_required": true
    },
    "streamingllm": {
      "ownership": "external",
      "implementation": "NVIDIA/kvpress KeyRerotationPress(StreamingLLMPress)",
      "kvpress_commit": "7331c23da9e6f1510d89ea651d0dea77a57b3252",
      "kvpress_version": "0.5.5",
      "n_sink": 4,
      "key_rerotation": true,
      "exact_budget_required": true
    }
  },
  "external_validation_gate": {
    "budgets": "all requested budgets",
    "every_observed_layer_must_match_budget": true,
    "one_token_generation_must_advance": true,
    "forward_hooks_must_restore": true,
    "fail_closed": true
  },
  "exclusions": {
    "AdaSnapKV": "excluded by design",
    "H2O": "deferred until independently parity-validated",
    "route_stability": "deferred to later sub-phase"
  },
  "runner": "experiments/kaggle_moe_phase02_multineedle_baselines.py",
  "requirements": "experiments/phase02_moe_baselines_requirements.txt",
  "tests": "tests/test_moe_phase02_benchmark.py"
}
